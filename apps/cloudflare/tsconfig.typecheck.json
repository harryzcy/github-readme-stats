{
  "extends": ["./tsconfig.json"],
  "compilerOptions": {
    "customConditions": [],

    // Typechecking resolves core through its build output, so no JavaScript
    // needs to be read. Leaving it on would instead pull in the backend's
    // `@ts-check`-annotated status handlers, which are not ours to check.
    "allowJs": false
  }
}
