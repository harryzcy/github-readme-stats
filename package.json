{
  "name": "github-readme-stats",
  "version": "1.0.0",
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "description": "Dynamically generate stats for your GitHub readme",
  "keywords": [
    "github-readme-stats",
    "readme-stats",
    "cards",
    "card-generator"
  ],
  "type": "module",
  "homepage": "https://github.com/harryzcy/github-readme-stats",
  "bugs": {
    "url": "https://github.com/harryzcy/github-readme-stats/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/harryzcy/github-readme-stats.git"
  },
  "scripts": {
    "test": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "build:packages": "turbo run build --filter=./packages/*",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.scripts.json",
    "build:frontend": "turbo run build --filter=./apps/frontend",
    "dev:frontend": "pnpm run --filter=./apps/frontend dev",
    "dev:backend": "pnpm run --filter=./apps/backend dev",
    "lint:eslint": "eslint",
    "lint:eslint:fix": "eslint --fix",
    "test:coverage": "vitest --config vitest.config.coverage.ts",
    "lint:knip": "knip",
    "lint:deps": "node scripts/assert-deduped.ts",
    "generate-theme-readme": "node scripts/generate-theme-readme.ts"
  },
  "author": "Anurag Hazra",
  "license": "MIT",
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "catalog:default",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.4.1",
    "globals": "17.13.0",
    "knip": "6.42.1",
    "prettier": "^3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "catalog:default"
  },
  "engines": {
    "node": ">=22"
  }
}
