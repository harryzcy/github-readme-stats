{
  "name": "github-readme-stats",
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.1+sha512.b58fbde6dca66a929538021581f648b4570b6ca19b18e7cbd7f2c07a7b24454155388dacdf08f2af3678e88a6d1fe04f9d609df24bf51735a060ea041b374ab7",
  "description": "Dynamically generate stats for your GitHub readme",
  "keywords": [
    "github-readme-stats",
    "readme-stats",
    "cards",
    "card-generator"
  ],
  "main": "src/index.js",
  "type": "module",
  "homepage": "https://github.com/harryzcy/github-readme-stats",
  "bugs": {
    "url": "https://github.com/harryzcy/github-readme-stats/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/harryzcy/github-readme-stats.git"
  },
  "scripts": {
    "test": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "build:packages": "turbo run build --filter=./packages/*",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.scripts.json",
    "build:frontend": "turbo run build --filter=./apps/frontend",
    "dev:frontend": "pnpm run --filter=./apps/frontend dev",
    "lint:eslint": "eslint",
    "lint:eslint:fix": "eslint --fix",
    "test:coverage": "vitest --config vitest.config.coverage.ts",
    "lint:knip": "knip",
    "lint:deps": "node scripts/assert-deduped.ts"
  },
  "author": "Anurag Hazra",
  "license": "MIT",
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.17.1",
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "catalog:default",
    "eslint": "10.7.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "63.1.0",
    "globals": "17.7.0",
    "knip": "6.27.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "2.10.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "catalog:default"
  },
  "lint-staged": {
    "*.{js,css,md}": "prettier --write"
  },
  "engines": {
    "node": ">=22"
  }
}
