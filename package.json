{
  "name": "github-readme-stats",
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "description": "Dynamically generate stats for your GitHub readme",
  "keywords": [
    "github-readme-stats",
    "readme-stats",
    "cards",
    "card-generator"
  ],
  "type": "module",
  "homepage": "https://github.com/harryzcy/github-readme-stats",
  "bugs": {
    "url": "https://github.com/harryzcy/github-readme-stats/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/harryzcy/github-readme-stats.git"
  },
  "scripts": {
    "test": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "build:packages": "turbo run build --filter=./packages/*",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.scripts.json",
    "build:frontend": "turbo run build --filter=./apps/frontend",
    "dev:frontend": "pnpm run --filter=./apps/frontend dev",
    "dev:backend": "pnpm run --filter=./apps/backend dev",
    "lint:eslint": "eslint",
    "lint:eslint:fix": "eslint --fix",
    "test:coverage": "vitest --config vitest.config.coverage.ts",
    "lint:knip": "knip",
    "lint:deps": "node scripts/assert-deduped.ts",
    "generate-theme-readme": "node scripts/generate-theme-readme"
  },
  "author": "Anurag Hazra",
  "license": "MIT",
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.19.1",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@vitest/coverage-v8": "catalog:default",
    "eslint": "10.10.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "64.3.4",
    "globals": "17.12.0",
    "knip": "6.36.0",
    "prettier": "^3.9.8",
    "turbo": "2.10.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "catalog:default"
  },
  "engines": {
    "node": ">=22"
  }
}
